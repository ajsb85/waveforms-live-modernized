{
  "compileOnSave": false,
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "ignoreDeprecations": "6.0",
    "isolatedModules": false,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2024"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noImplicitOverride": false,
    "noImplicitReturns": false,
    "noPropertyAccessFromIndexSignature": false,
    "noFallthroughCasesInSwitch": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "digilent-chart-angular2/modules": [
        "src/compat/digilent-chart-angular2/modules.ts"
      ],
      "dip-angular2/services": [
        "src/compat/dip-angular2/services.ts"
      ],
      "ionic-angular": [
        "src/compat/ionic-angular.ts"
      ],
      "ionic-native": [
        "src/compat/ionic-native.ts"
      ],
      "rxjs/Observable": [
        "src/compat/rxjs-observable.ts"
      ],
      "rxjs/Rx": [
        "src/compat/rxjs-compat.ts"
      ],
      "rxjs/Subject": [
        "src/compat/rxjs-subject.ts"
      ]
    },
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": false,
    "target": "ES2024",
    "types": [
      "node"
    ],
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": false,
    "strictInputAccessModifiers": false,
    "strictTemplates": false
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}

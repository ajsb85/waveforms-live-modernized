{
  "name": "waveforms-live",
  "version": "1.4.10",
  "author": "Digilent",
  "homepage": "https://digilent.com/",
  "main": "electron.js",
  "private": true,
  "packageManager": "npm@11.14.1",
  "scripts": {
    "ng": "ng",
    "clean": "rm -rf www .angular/cache",
    "start": "ng serve --host 127.0.0.1",
    "dev": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "npm run build:prod && npm run e2e",
    "e2e": "playwright test",
    "manualUpdateVersion": "node versionManager.js",
    "buildElectronWindows": "npm run build:prod && electron-packager . --platform=win32 --arch=x64 --out=electron-builds/windows --icon=src/assets/icon/favicon.ico --overwrite",
    "buildElectronLinux": "npm run build:prod && electron-packager . --platform=linux --arch=x64 --out=electron-builds/linux --icon=src/assets/icon/favicon.ico --overwrite"
  },
  "dependencies": {
    "@angular/animations": "22.0.1",
    "@angular/common": "22.0.1",
    "@angular/compiler": "22.0.1",
    "@angular/core": "22.0.1",
    "@angular/forms": "22.0.1",
    "@angular/platform-browser": "22.0.1",
    "@angular/platform-browser-dynamic": "22.0.1",
    "@angular/router": "22.0.1",
    "@capacitor/app": "8.1.0",
    "@capacitor/browser": "8.0.3",
    "@capacitor/core": "8.3.4",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/splash-screen": "8.0.1",
    "@capacitor/status-bar": "8.0.2",
    "@ionic/angular": "8.8.8",
    "@ionic/core": "8.8.8",
    "@ionic/storage-angular": "4.0.0",
    "@stencil/core": "4.43.4",
    "ionicons": "8.0.13",
    "mathjs": "15.2.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular/build": "22.0.1",
    "@angular/cli": "21.2.12",
    "@angular/compiler-cli": "21.2.14",
    "@playwright/test": "1.60.0",
    "@types/node": "25.9.1",
    "electron": "42.2.0",
    "@electron/packager": "20.0.0",
    "sass": "1.100.0",
    "typescript": "6.0.3",
    "vite": "8.0.14"
  },
  "description": "WaveForms Live modern Angular web application"
}
